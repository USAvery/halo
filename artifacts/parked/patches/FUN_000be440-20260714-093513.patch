diff --git c/src/halo/game/players.c w/src/halo/game/players.c
index 0b085063..0d797083 100644
--- c/src/halo/game/players.c
+++ w/src/halo/game/players.c
@@ -2386,3 +2386,30 @@ void player_rumble_initialize(int16_t function_index, int thread_handle,
     hs_return(thread_handle, 0);
   }
 }
+
+/* FUN_000be440 @ 0x000be440
+ *
+ * HaloScript function-evaluator wrapper, sibling of player_rumble_initialize
+ * (0x000be400). Evaluates the script function via
+ * hs_macro_function_evaluate(function_index, thread_datum, init); on a non-zero
+ * evaluation result it calls the no-argument helper FUN_000c9e50() and then
+ * completes the thread with hs_return(thread_datum, 0).
+ *
+ * cdecl frame:
+ *   function_index  int16_t  [ESP+0x04]
+ *   thread_datum    int      [ESP+0x08]
+ *   init            char     [ESP+0x0c]
+ *
+ * hs_macro_function_evaluate returns an evaluation record in EAX. Unlike the
+ * 0xbe400 sibling, this variant does not read any record fields; the result is
+ * used only as a non-NULL guard (iVar1 != 0). */
+void FUN_000be440(int16_t function_index, int thread_datum, char init)
+{
+  int record;
+
+  record = hs_macro_function_evaluate(function_index, thread_datum, init);
+  if (record != 0) {
+    FUN_000c9e50();
+    hs_return(thread_datum, 0);
+  }
+}
