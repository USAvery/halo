+
+/* FUN_00184570: predicate over the presorted transparent-geometry group
+ * bitmap at 0x4d0cbc (0x30-byte / 384-bit table, zeroed at rasterizer_text.c
+ * init). Maps the group pointer to its presorted index; returns 1 when the
+ * index is invalid (-1) or the group's bit is clear, 0 when the bit is set.
+ * Bit layout: dword = index>>5, bit = index&0x1f. (0x184570) */
+char FUN_00184570(void *group)
+{
+  short index;
+  int idx;
+
+  index = rasterizer_transparent_geometry_group_to_presorted_index(
+    (unsigned int)group);
+  if (index != -1) {
+    idx = (int)index;
+    return (char)('\x01' -
+                  (((1 << (idx & 0x1f)) &
+                    *(unsigned int *)(0x4d0cbc + (idx >> 5) * 4)) != 0));
+  }
+  return '\x01';
+}
