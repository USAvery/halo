+/* Virtual keyboard move-left handler (0xf5660, virtual_keyboard.obj).
+ * Steps the column cursor (0x46cefa) one place left through the 11-column
+ * keymap row selected by the row cursor (0x46cef8), wrapping 0 -> 10, and
+ * skips over columns whose keymap byte equals the starting cell's byte (so a
+ * run of identical keys collapses into a single logical step). Commits the
+ * new column, plays the UI move feedback sound, and always returns 1 (a move
+ * always occurs). Faithful shape: the original caches the column in a
+ * register (AX) across the loop and writes 0x46cefa back exactly once, after
+ * the loop settles -- not on every iteration as the raw decompiler shows. */
+char FUN_000f5660(void)
+{
+  int row_base; /* ECX: keymap row base = row * 11 */
+  short col; /* AX : working copy of column cursor 0x46cefa */
+  char start_key; /* DL : keymap byte at the starting cell */
+
+  row_base = *(short *)0x46cef8 * 0xb;
+  col = *(short *)0x46cefa;
+  start_key = ((char *)0x28a790)[col + row_base];
+  do {
+    col = col - 1;
+    if (col < 0) {
+      col = 10;
+    }
+  } while (((char *)0x28a790)[col + row_base] == start_key);
+  *(short *)0x46cefa = col;
+  ui_play_audio_feedback_sound(1);
+  return 1;
+}
