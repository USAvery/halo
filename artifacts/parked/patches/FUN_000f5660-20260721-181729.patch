+/* Virtual keyboard cursor move handler: step the keymap column cursor
+ * left (0xf5660, virtual_keyboard.obj TU).
+ *
+ * Decrements the column cursor at 0x46cefa through the 11 columns of the
+ * current row (wrapping -1 -> 10), skipping columns whose key character
+ * (keymap byte at 0x28a790[col + row*0xb]) equals the character under the
+ * pre-move cursor, so duplicate/merged keys are stepped over in one press.
+ * Stores the new column, plays the UI cursor-move sound (selector 1), and
+ * returns 1 (move accepted -> caller latches last_move_dir/last_move_time).
+ * Sibling of FUN_000f56b0/5700/5750/5fb0/57a0.
+ *
+ * Disasm notes: col is held in AX for the whole loop (16-bit dec, signed
+ * jns wrap to 10) and stored to the global once after the loop; the
+ * pre-move key byte is cached in DL before the loop; row (0x46cef8) is
+ * MOVSX-loaded once. MOV AL,1 before RET -> char return; PUSH 1 is the
+ * audio-selector argument (Ghidra dropped the arg and mistyped return as
+ * void; corrected against disassembly). */
+char FUN_000f5660(void)
+{
+  short row;
+  short col;
+  char original_key;
+
+  col = *(short *)0x46cefa;
+  row = *(short *)0x46cef8;
+  original_key = ((char *)0x28a790)[row * 0xb + (int)col];
+  do {
+    col = (short)(col - 1);
+    if (col < 0) {
+      col = 10;
+    }
+  } while (((char *)0x28a790)[row * 0xb + (int)col] == original_key);
+  *(short *)0x46cefa = col;
+  ui_play_audio_feedback_sound(1);
+  return 1;
+}
