+/* Virtual keyboard cursor move handler: advance the keymap column cursor
+ * to the next distinct key (0xf56b0, virtual_keyboard.obj TU).
+ *
+ * Increments the column cursor at 0x46cefa modulo 11 (0xb columns per
+ * keymap row), skipping columns whose key character (keymap byte at
+ * 0x28a790[col + row*0xb]) equals the character under the pre-move cursor,
+ * so duplicate/merged keys are stepped over in one press. The row cursor
+ * (0x46cef8) is held fixed. Stores the new column, plays the UI cursor-move
+ * sound (selector 1), and returns 1 (move accepted -> caller latches
+ * last_move_dir/last_move_time). Sibling of FUN_000f5660/5700/5750/5fb0.
+ *
+ * Disasm notes: col is loaded from 0x46cefa into AX (16-bit word) and held
+ * there for the whole loop (16-bit inc; CMP AX,0xb; XOR AX,AX wrap to 0),
+ * stored to the global once after the loop; the pre-move key byte is cached
+ * in DL (MOV DL,byte ptr [...]) before the loop; row (0x46cef8) is
+ * MOVSX-loaded once into ECX and multiplied by 0xb. MOV AL,1 before RET ->
+ * char return; PUSH 1 is the audio-selector argument (Ghidra dropped it). */
+char FUN_000f56b0(void)
+{
+  short row;
+  short col;
+  char original_key;
+
+  row = *(short *)0x46cef8;
+  col = *(short *)0x46cefa;
+  original_key = ((char *)0x28a790)[(int)col + row * 0xb];
+  do {
+    col = (short)(col + 1);
+    if (col == 0xb) {
+      col = 0;
+    }
+  } while (((char *)0x28a790)[(int)col + row * 0xb] == original_key);
+  *(short *)0x46cefa = col;
+  ui_play_audio_feedback_sound(1);
+  return 1;
+}
