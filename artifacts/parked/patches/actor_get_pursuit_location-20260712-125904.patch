+/* actor_get_pursuit_location (0x1d4f0) — Return a pointer to an actor's
+ * pursuit-location field, or NULL when the actor is not in a pursuit state.
+ *
+ * Resolves the actor record via datum_get(actor_data, actor_index), reads the
+ * 16-bit state/type field at actor+0x6c, and returns a pointer into the actor
+ * struct at actor+0xa4 (the pursuit location) when that state is 7 or 5.
+ * Otherwise returns NULL (EDX is pre-zeroed and copied to EAX in the original).
+ *
+ * Confirmed: datum_get(actor_data, actor_index) at 0x1d437-region; two pushes
+ *   (ECX=actor_data global @0x6325a4, EAX=actor_index) cleaned by ADD ESP,8.
+ * Confirmed: state read at actor+0x6c is 16-bit (MOV CX / CMP CX) — kept as
+ *   int16_t to preserve the narrow load width; the two magic states 7 and 5
+ *   and the +0xa4 offset are literal from the binary.
+ * Inferred: the return is an address into the actor struct, not a copied
+ *   value — returned as (char *)actor + 0xa4. */
+void *actor_get_pursuit_location(int actor_index)
+{
+  char *actor;
+  int16_t state;
+
+  actor = (char *)datum_get(actor_data, actor_index);
+  state = *(int16_t *)(actor + 0x6c);
+  if (state == 7 || state == 5) {
+    return actor + 0xa4;
+  }
+  return NULL;
+}
