+/* Virtual on-screen keyboard column-cursor advance handler (0xf56b0).
+ * TU: c:\halo\SOURCE\interface\virtual_keyboard.c.
+ *
+ * Dispatch case 1 (analog +X / "next") of virtual_keyboard_process_input.
+ * Advances the column cursor (0x46cefa) forward with wraparound at 11,
+ * skipping keymap entries identical to the starting key so the cursor lands
+ * on a genuinely different character, then plays the UI "cursor" feedback
+ * sound (selector 1). Keymap at 0x28a790 is signed bytes indexed
+ * [col + row*0xb]; row selector is 0x46cef8. The starting entry is loop-
+ * invariant (hoisted). Always accepts the move: returns 1 in AL. */
+char FUN_000f56b0(void)
+{
+  int row;
+  short cur;
+  char target;
+
+  row = (int)*(short *)0x46cef8 * 0xb;
+  cur = *(short *)0x46cefa;
+  target = ((char *)0x28a790)[cur + row];
+  do {
+    cur = cur + 1;
+    if (cur == 0xb) {
+      cur = 0;
+    }
+  } while (((char *)0x28a790)[cur + row] == target);
+  *(short *)0x46cefa = cur;
+  ui_play_audio_feedback_sound(1);
+  return 1;
+}
