+/* Fold two boolean flags from a parameter block into an equipment object
+ * (0xf6750).
+ *
+ * Verifies object_handle names an equipment object (type mask 8), then applies
+ * the parameter block's flag byte at +0x22:
+ *   - bit 0 (&1): when set, sets object flag 0x20 at obj+0x04; when clear,
+ *     clears it AND advances the float at obj+0x14 by 0.05.
+ *   - bit 2 (&4): when clear, sets flag 0x20 at obj+0x1a4; when set, clears it
+ *     (inverted sense relative to bit 0).
+ * Object flags 0x60000 at obj+0x04 are always set; the original reuses the
+ * just-computed flag value in a register, emitting a second store to obj+0x04
+ * rather than a reload, so both stores are kept to preserve that shape.
+ *
+ * ABI: two cdecl stack args; one call (object_get_and_verify_type). */
+void FUN_000f6750(int object_handle, int params)
+{
+  int *equip_obj;
+  unsigned int new_flags;
+
+  equip_obj = (int *)object_get_and_verify_type(object_handle, 8);
+
+  if ((*(unsigned char *)(params + 0x22) & 1) != 0)
+    new_flags = *(unsigned int *)((char *)equip_obj + 4) | 0x20;
+  else
+    new_flags = *(unsigned int *)((char *)equip_obj + 4) & 0xffffffdf;
+  *(unsigned int *)((char *)equip_obj + 4) = new_flags;
+  *(unsigned int *)((char *)equip_obj + 4) = new_flags | 0x60000;
+
+  if ((*(unsigned char *)(params + 0x22) & 4) == 0)
+    *(unsigned int *)((char *)equip_obj + 0x1a4) |= 0x20;
+  else
+    *(unsigned int *)((char *)equip_obj + 0x1a4) &= 0xffffffdf;
+
+  if ((*(unsigned char *)(params + 0x22) & 1) == 0)
+    *(float *)((char *)equip_obj + 0x14) += 0.05f;
+}
