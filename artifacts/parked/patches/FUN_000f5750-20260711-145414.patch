+/* Virtual keyboard "cursor down" move handler (virtual_keyboard.obj, 0xf5750).
+ * Advances the keymap cursor row (virtual_keyboard_globals cursor @0x46cef8,
+ * a signed 16-bit index in [0,5)) to the next row whose keymap byte differs
+ * from the current row's byte, wrapping 4 -> 0. The keymap byte is read from
+ * the char[5][0xb] dispatch table at 0x28a790 as table[col + row*0xb], where
+ * col is the cursor column @0x46cefa (signed 16-bit). The current row's byte
+ * is cached once before the loop (DL in the original); the cursor is held in a
+ * register and written back to the global only after the loop settles. Then a
+ * UI cursor feedback sound (selector 1) is played. Always returns 1 ("moved").
+ * Binary: MOV AL,1; RET. */
+char FUN_000f5750(void)
+{
+  short cursor;
+  int col;
+  char row_byte;
+
+  cursor = *(short *)0x46cef8;
+  col = *(short *)0x46cefa;
+  row_byte = ((char *)0x28a790)[col + cursor * 0xb];
+
+  do {
+    cursor = cursor + 1;
+    if (cursor == 5)
+      cursor = 0;
+  } while (((char *)0x28a790)[col + cursor * 0xb] == row_byte);
+
+  *(short *)0x46cef8 = (short)cursor;
+  ui_play_audio_feedback_sound(1);
+  return 1;
+}
