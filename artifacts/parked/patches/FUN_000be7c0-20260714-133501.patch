+/* 0xbe7c0 — HS script "recorded animation playback" macro handler.
+ * Evaluates the macro arguments via hs_macro_function_evaluate; on success the
+ * result block holds a dword at +0x0 and a zero-extended u16 at +0x4 (disasm:
+ * XOR EDX; MOV DX,[EAX+4] — do NOT sign-extend). Passes both to
+ * recorded_animation_play_and_delete (2-arg cdecl, returns a byte in AL), then
+ * returns that byte to the script thread. A single ADD ESP,0x10 at 0xbe800
+ * merges the consumer's and hs_return's cleanups, confirming the 2-arg call.
+ */
+void FUN_000be7c0(int16_t function_index, int thread_datum, char init)
+{
+  int *result;
+
+  result =
+    (int *)hs_macro_function_evaluate(function_index, thread_datum, init);
+  if (result != NULL) {
+    hs_return(thread_datum,
+              (unsigned char)recorded_animation_play_and_delete(
+                result[0], *(uint16_t *)(result + 1)));
+  }
+}
