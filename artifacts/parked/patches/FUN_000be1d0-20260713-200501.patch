+/* 0xbe1d0 — HS macro-function evaluator dispatch wrapper. Evaluates a macro
+ * (built-in) function for the given thread via hs_macro_function_evaluate. If
+ * that evaluation reports it produced a result (nonzero return), finalizes the
+ * current expression frame (FUN_000ca140) and commits a 0 result back to the
+ * thread with hs_return(thread_datum, 0).
+ *
+ * Cdecl stack params: [esp+4]=int16_t function_index, [esp+8]=int thread_datum,
+ * [esp+0xc]=char init. Ghidra mis-declared this (void); the three params flow
+ * directly into the callees (thread_datum is reused as hs_return's handle arg).
+ */
+void FUN_000be1d0(int16_t function_index, int thread_datum, char init)
+{
+  int result;
+
+  result = hs_macro_function_evaluate(function_index, thread_datum, init);
+  if (result != 0) {
+    FUN_000ca140();
+    hs_return(thread_datum, 0);
+  }
+}
