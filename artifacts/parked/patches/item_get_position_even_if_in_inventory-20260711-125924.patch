+/* Fetch an item's world position, even while it is carried in a unit's
+ * inventory (0xf6a60). out_position is zero-filled up front. If the item
+ * is not in inventory (flag bit0 at +0x1a4 clear), copies the item's own
+ * position at +0x50/+0x54/+0x58. If it is in inventory, resolves the
+ * owning player (handle at +0x70) via the player_data pool, then that
+ * player's unit object (handle at +0x34) and copies the unit's position.
+ * Positions are raw dword copies; no FPU math. Faithful to the original:
+ * the in-inventory branch dereferences the datum_get() result without a
+ * NULL check. */
+void item_get_position_even_if_in_inventory(int item_handle,
+                                            float *out_position)
+{
+  char *item_obj;
+  char *player;
+  char *unit_obj;
+
+  item_obj = (char *)object_try_and_get_and_verify_type(item_handle, 0x1c);
+  out_position[0] = 0;
+  out_position[1] = 0;
+  out_position[2] = 0;
+  if (item_obj != NULL) {
+    if ((*(unsigned char *)(item_obj + 0x1a4) & 1) != 0) {
+      if (*(int *)(item_obj + 0x70) != NONE) {
+        player =
+          (char *)datum_get(*(data_t **)0x5aa6d4, *(int *)(item_obj + 0x70));
+        if (*(int *)(player + 0x34) != NONE) {
+          unit_obj =
+            (char *)object_get_and_verify_type(*(int *)(player + 0x34), 3);
+          out_position[0] = *(float *)(unit_obj + 0x50);
+          out_position[1] = *(float *)(unit_obj + 0x54);
+          out_position[2] = *(float *)(unit_obj + 0x58);
+        }
+      }
+    } else {
+      out_position[0] = *(float *)(item_obj + 0x50);
+      out_position[1] = *(float *)(item_obj + 0x54);
+      out_position[2] = *(float *)(item_obj + 0x58);
+    }
+  }
+}
