+/* Virtual keyboard "activate current key" handler (0xf5fb0, __cdecl).
+ * Dispatched as action 4 by FUN_000f63f0; returns char 1 in AL on every path
+ * (MOV AL,1 at the single epilogue), which latches last_move_dir/last_move_time
+ * in the caller. The kb decl "char FUN_000f5fb0(void)" is correct; Ghidra's
+ * "void" is wrong (it lost the AL return the caller reads).
+ *
+ * Resolves the key code from the layout table at 0x28a790, indexed
+ * [cursor_row(0x46cef8)*0xb + cursor_col(0x46cefa)] as a signed char, then
+ * dispatches. Codes 0x24-0x2b are special keys; everything else inserts a
+ * character. The layout lookup is recomputed inline in three places (switch
+ * subject, char-resolver arg, shift-clear epilogue) to match the original's
+ * three MOVSX/IMUL/MOVSX sequences rather than a cached local.
+ *
+ *   0x24 '$'  Done/OK: accept (0x46cf06=1) if the edit buffer equals the
+ *             confirm buffer (0x46cf18) or is a unique save name; else show
+ *             error 0x1d (empty) / 0x1b (dup) and reset via FUN_000f57a0.
+ *   0x25 '%'  toggle shift (0x46cef1); 0x26/0x27 toggle 0x46cef2/0x46cef3.
+ *   0x28      clear-all when dirty (0x46cf07==1) else backspace (FUN_000f5f30).
+ *   0x29/0x2a move the caret left/right within the buffer (2-byte wchar steps).
+ *   0x2b      insert a space: shift the tail right by one wchar then store L'
+ * '. default   insert the resolved wide char. FUN_000f5800 takes the key code
+ *             in ESI (@<esi>) and returns the shift/alt-resolved wchar in AX.
+ *             Typing ".fortune" seeds 0x46cf04 from system_milliseconds()%10.
+ *
+ * The epilogue clears shift (0x46cef1) unless the pressed key IS the shift key
+ * '%'. The three buffer_size>0 asserts reproduce the original display_assert +
+ * system_exit(-1) at source lines 0x355/0x378/0x391.
+ * Globals: 0x46cef8/0x46cefa row/col, 0x46cefc buffer_size (bytes, MOVZX),
+ * 0x46cf07 dirty flag, 0x46cf08 buffer base, 0x46cf0c caret, 0x46cf18 confirm
+ * buffer, 0x28aa44 = L".fortune". */
+char FUN_000f5fb0(void)
+{
+  char *cursor;
+  int shift_size;
+  unsigned int buf_cap;
+  unsigned int fortune_index;
+
+  switch (((char *)0x28a790)[*(short *)0x46cef8 * 0xb + *(short *)0x46cefa]) {
+  case 0x24: /* '$' : Done / OK */
+    if (ustrcmp((wchar_t *)0x46cf18, *(wchar_t **)0x46cf08) == 0) {
+      *(char *)0x46cf06 = 1;
+    } else if (**(wchar_t **)0x46cf08 == L'\0') {
+      ui_widget_display_error(0x1d, -1, 1, 0);
+      FUN_000f57a0();
+    } else if (saved_game_file_name_unique(*(wchar_t **)0x46cf08)) {
+      *(char *)0x46cf06 = 1;
+    } else {
+      ui_widget_display_error(0x1b, -1, 1, 0);
+      FUN_000f57a0();
+    }
+    ui_play_audio_feedback_sound(3);
+    *(char *)0x46cef0 = 0;
+    event_manager_flush();
+    break;
+  case 0x25: /* '%' : toggle shift */
+    ui_play_audio_feedback_sound(1);
+    *(char *)0x46cef1 = (*(char *)0x46cef1 == 0);
+    break;
+  case 0x26: /* toggle modifier */
+    ui_play_audio_feedback_sound(1);
+    *(char *)0x46cef2 = (*(char *)0x46cef2 == 0);
+    break;
+  case 0x27: /* toggle modifier */
+    ui_play_audio_feedback_sound(1);
+    *(char *)0x46cef3 = (*(char *)0x46cef3 == 0);
+    break;
+  case 0x28: /* clear-all / backspace */
+    if (*(char *)0x46cf07 == 1) {
+      if (*(short *)0x46cefc == 0) {
+        display_assert("virtual_keyboard_globals.buffer_size>0",
+                       "c:\\halo\\SOURCE\\interface\\virtual_keyboard.c", 0x355,
+                       true);
+        system_exit(-1);
+      }
+      csmemset(*(char **)0x46cf08, 0,
+               (unsigned int)*(unsigned short *)0x46cefc);
+      *(char **)0x46cf0c = *(char **)0x46cf08;
+      *(char *)0x46cf07 = 0;
+    } else {
+      FUN_000f5f30();
+    }
+    break;
+  case 0x29: /* caret left */
+    if (*(char **)0x46cf08 < *(char **)0x46cf0c)
+      *(char **)0x46cf0c -= 2;
+    *(char *)0x46cf07 = 0;
+    ui_play_audio_feedback_sound(1);
+    break;
+  case 0x2a: /* caret right */
+    if (**(short **)0x46cf0c != 0)
+      *(char **)0x46cf0c += 2;
+    *(char *)0x46cf07 = 0;
+    ui_play_audio_feedback_sound(1);
+    break;
+  case 0x2b: /* insert a space */
+    if (*(char *)0x46cf07 == 1) {
+      if (*(short *)0x46cefc == 0) {
+        display_assert("virtual_keyboard_globals.buffer_size>0",
+                       "c:\\halo\\SOURCE\\interface\\virtual_keyboard.c", 0x378,
+                       true);
+        system_exit(-1);
+      }
+      csmemset(*(char **)0x46cf08, 0,
+               (unsigned int)*(unsigned short *)0x46cefc);
+      *(char **)0x46cf0c = *(char **)0x46cf08;
+      *(char *)0x46cf07 = 0;
+    }
+    if (object_get_type() < 2) {
+      ui_play_audio_feedback_sound(4);
+    } else {
+      cursor = *(char **)0x46cf0c;
+      shift_size = ((int)*(unsigned short *)0x46cefc - (int)cursor) - 2 +
+                   (int)*(char **)0x46cf08;
+      csmemmove(cursor + 2, cursor, (unsigned int)shift_size);
+      **(wchar_t **)0x46cf0c = L' ';
+      *(char **)0x46cf0c += 2;
+      ui_play_audio_feedback_sound(2);
+    }
+    break;
+  default: /* insert the resolved character */
+    if (*(char *)0x46cf07 == 1) {
+      if (*(short *)0x46cefc == 0) {
+        display_assert("virtual_keyboard_globals.buffer_size>0",
+                       "c:\\halo\\SOURCE\\interface\\virtual_keyboard.c", 0x391,
+                       true);
+        system_exit(-1);
+      }
+      csmemset(*(char **)0x46cf08, 0,
+               (unsigned int)*(unsigned short *)0x46cefc);
+      *(char **)0x46cf0c = *(char **)0x46cf08;
+      *(char *)0x46cf07 = 0;
+    }
+    buf_cap = *(unsigned short *)0x46cefc;
+    if ((int)(buf_cap - (ustrlen(*(unsigned short **)0x46cf08) * 2 + 2)) < 2) {
+      ui_play_audio_feedback_sound(4);
+    } else {
+      cursor = *(char **)0x46cf0c;
+      shift_size = ((int)buf_cap - (int)cursor) - 2 + (int)*(char **)0x46cf08;
+      csmemmove(cursor + 2, cursor, (unsigned int)shift_size);
+      **(wchar_t **)0x46cf0c = FUN_000f5800(
+        ((char *)0x28a790)[*(short *)0x46cef8 * 0xb + *(short *)0x46cefa]);
+      *(char **)0x46cf0c += 2;
+      if (ustrcmp(*(wchar_t **)0x46cf08, (wchar_t *)0x28aa44) == 0) {
+        fortune_index = system_milliseconds() % 10;
+        if (fortune_index > 9)
+          fortune_index = 9;
+        *(short *)0x46cf04 = (short)(fortune_index + 0xb);
+        if (*(short *)0x46cf18 == 0) {
+          csmemset(*(char **)0x46cf08, 0,
+                   (unsigned int)*(unsigned short *)0x46cefc);
+          *(char **)0x46cf0c = *(char **)0x46cf08;
+        } else {
+          align_to_character(*(wchar_t **)0x46cf08, (wchar_t *)0x46cf18);
+          *(char **)0x46cf0c =
+            *(char **)0x46cf08 + ustrlen(*(unsigned short **)0x46cf08) * 2;
+        }
+      }
+      ui_play_audio_feedback_sound(2);
+    }
+  }
+
+  if (((char *)0x28a790)[*(short *)0x46cef8 * 0xb + *(short *)0x46cefa] != 0x25)
+    *(char *)0x46cef1 = 0;
+  return 1;
+}
