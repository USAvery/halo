diff --git c/src/halo/items/items.c w/src/halo/items/items.c
index a7bf74cc..c98e9357 100644
--- c/src/halo/items/items.c
+++ w/src/halo/items/items.c
@@ -110,6 +110,43 @@ bool virtual_keyboard_initialize(void)
   return *(void **)0x46cef4 != (void *)0;
 }
 
+/*
+ * FUN_000f5660 @ 0xf5660  (items.obj)
+ *
+ * Step the UI item-variant selector BACKWARD to the previous entry whose
+ * table value differs from the current one, then play audio feedback.
+ *
+ * Globals (all confirmed from disassembly, raw pointer access):
+ *   *(short *)0x46cef8   row/set selector           (MOVSX word)
+ *   *(short *)0x46cefa   current variant index      (MOVSX word; cycles 0..10)
+ *   (char *)0x28a790     byte table[row*11 + index] (BYTE loads/compares)
+ *
+ * The original caches the current cell value in a register (DL) and keeps the
+ * decrementing index in AX, writing it back to the global only once after the
+ * loop; the local `current_value`/`index` reproduce that. Decrement wraps
+ * 0 -> -1 -> 10 (DEC AX; JNS; MOV AX,10). Always returns 1 (MOV AL,1).
+ * Tail call passes sound id 1 (PUSH 1; CALL 0xe5ab0; ADD ESP,4).
+ */
+char FUN_000f5660(void)
+{
+  int row_base;
+  short index;
+  char current_value;
+
+  row_base = (int)*(short *)0x46cef8 * 0xb;
+  index = *(short *)0x46cefa;
+  current_value = *(char *)(0x28a790 + row_base + index);
+  do {
+    index--;
+    if (index < 0) {
+      index = 10;
+    }
+  } while (*(char *)(0x28a790 + row_base + index) == current_value);
+  *(short *)0x46cefa = index;
+  ui_play_audio_feedback_sound(1);
+  return 1;
+}
+
 #include "x87_math.h"
 
 /* Activate the pickup sound effect for an equipment item.
