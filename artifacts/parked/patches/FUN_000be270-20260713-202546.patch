diff --git c/src/halo/game/players.c w/src/halo/game/players.c
index 6092c6ee..d09d094d 100644
--- c/src/halo/game/players.c
+++ w/src/halo/game/players.c
@@ -2357,3 +2357,30 @@ void players_update_after_game(void)
   if (*(char *)0x449ef1 != 0 && *(char *)0x2f0e90 != 0)
     profile_exit_private((void *)0x2f0e88);
 }
+
+/* FUN_000be270 @ 0x000be270 (players.obj)
+ * HaloScript macro-function thread step. Evaluates the macro function for a
+ * script thread; if the evaluation yields a result node, dispatches it and
+ * returns from the thread.
+ *
+ * Signature recovered from disassembly (kb decl was `void(void)`): three cdecl
+ * stack args at [ebp+8]/[ebp+c]/[ebp+10].
+ *
+ * NOTE: hs_macro_function_evaluate is declared `int`-returning in kb but the
+ * body dereferences it as a pointer to a node { int value; int16 type; }.
+ * FUN_000ca3f0's kb decl was also wrong (`void(void)`); the call site pushes
+ * two args (node.value, node.type) — corrected to `void(int,int)` in kb.json.
+ */
+void FUN_000be270(int16_t function_index, int thread_datum, char init)
+{
+  int *result;
+
+  result =
+    (int *)hs_macro_function_evaluate(function_index, thread_datum, init);
+  if (result != 0) {
+    /* ca3f0(*(int*)(result+0), *(uint16*)(result+4)) — args from result node.
+     */
+    FUN_000ca3f0(result[0], *(unsigned short *)((char *)result + 4));
+    hs_return(thread_datum, 0);
+  }
+}
